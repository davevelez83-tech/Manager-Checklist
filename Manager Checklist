<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cane &amp; Barrel — Nightly Manager Closing Checklist</title>
<style>
  :root {
    --bg: #f5f2ec;
    --surface: #ffffff;
    --surface-2: #efe9df;
    --surface-checked: #f3ede1;
    --ink: #23201b;
    --ink-soft: #6b6459;
    --ink-muted: #97907f;
    --line: #ddd5c7;
    --line-strong: #c9c0ae;
    --accent: #b07d2b;
    --accent-ink: #7a5417;
    --accent-soft: #f0e2c6;
    --ok: #2f7d4f;
    --miss: #b23b2e;
    --miss-bg: #f9e6e2;
    --shadow: 0 1px 2px rgba(35,32,27,.06), 0 6px 20px rgba(35,32,27,.06);
    --radius: 12px;
    --tap: 46px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1815;
      --surface: #24211d;
      --surface-2: #2c2823;
      --surface-checked: #262019;
      --ink: #eee7da;
      --ink-soft: #b3ab9c;
      --ink-muted: #857e70;
      --line: #38332c;
      --line-strong: #48423a;
      --accent: #d9a94f;
      --accent-ink: #e9c579;
      --accent-soft: #3a3120;
      --ok: #6fc48d;
      --miss: #e57a6d;
      --miss-bg: #3a221e;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 6px 20px rgba(0,0,0,.35);
    }
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.4;
    -webkit-text-size-adjust: 100%;
    padding-bottom: 40px;
  }

  .wrap { max-width: 900px; margin: 0 auto; padding: 0 16px; }

  /* Masthead */
  .masthead {
    padding: 22px 16px 14px;
    text-align: center;
    border-bottom: 1px solid var(--line);
  }
  .masthead .brand {
    font-size: 13px;
    letter-spacing: .22em;
    font-weight: 700;
    color: var(--accent-ink);
    text-transform: uppercase;
  }
  .masthead .rule {
    width: 46px; height: 2px; background: var(--accent);
    margin: 10px auto 0; border-radius: 2px;
  }

  /* Sticky header controls */
  .controls {
    position: sticky; top: 0; z-index: 40;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .controls-inner { padding: 12px 16px; }
  .ctl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 12px;
  }
  @media (min-width: 640px) {
    .ctl-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .field label {
    font-size: 11px; letter-spacing: .09em; text-transform: uppercase;
    color: var(--ink-muted); font-weight: 700;
  }
  .field select, .field input[type="text"] {
    width: 100%; min-height: var(--tap);
    background: var(--surface-2); color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: 10px;
    padding: 6px 10px; font-size: 15px; font-family: inherit;
  }
  .field .static {
    min-height: var(--tap); display: flex; align-items: center;
    padding: 6px 10px; font-size: 15px; font-weight: 600;
    background: var(--surface-2); border: 1px dashed var(--line-strong);
    border-radius: 10px; color: var(--ink-soft);
  }
  select:focus-visible, input:focus-visible, button:focus-visible, .row:focus-visible, .sec-head:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }

  .progress-wrap { margin-top: 12px; }
  .progress-top {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 6px;
  }
  .progress-top .count { font-size: 14px; font-weight: 700; }
  .progress-top .count b { color: var(--accent-ink); }
  .progress-actions { display: flex; gap: 8px; }
  .btn-clear {
    min-height: 38px; padding: 0 12px; font-size: 13px; font-weight: 600;
    background: transparent; color: var(--ink-soft);
    border: 1px solid var(--line-strong); border-radius: 9px; cursor: pointer;
    font-family: inherit;
  }
  .btn-clear:active { background: var(--surface-2); }
  .bar {
    height: 6px; width: 100%; background: var(--surface-2);
    border-radius: 999px; overflow: hidden;
  }
  .bar > i {
    display: block; height: 100%; width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--accent-ink));
    border-radius: 999px; transition: width .25s ease;
  }

  .instructions {
    font-size: 12.5px; color: var(--ink-soft);
    padding: 10px 16px 0; line-height: 1.5;
  }

  /* Sections */
  .sections { padding: 14px 16px 0; }
  .section {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); margin-bottom: 12px; overflow: hidden;
    box-shadow: var(--shadow);
  }
  .sec-head {
    display: flex; align-items: center; gap: 10px;
    width: 100%; text-align: left; cursor: pointer;
    padding: 14px 16px; min-height: var(--tap);
    background: var(--surface); border: 0; border-bottom: 1px solid transparent;
    font-family: inherit; color: var(--ink);
  }
  .section.open .sec-head { border-bottom-color: var(--line); }
  .sec-head .chev {
    flex: 0 0 auto; transition: transform .2s ease; color: var(--ink-muted);
    font-size: 13px; width: 16px;
  }
  .section.open .sec-head .chev { transform: rotate(90deg); }
  .sec-head .title {
    flex: 1 1 auto; font-size: 13px; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
  }
  .sec-head .sec-count {
    flex: 0 0 auto; font-size: 12px; font-weight: 700;
    color: var(--ink-soft); background: var(--surface-2);
    padding: 3px 9px; border-radius: 999px; white-space: nowrap;
  }
  .section.done .sec-head .sec-count { color: var(--ok); background: var(--accent-soft); }
  .sec-head .tick { color: var(--ok); font-weight: 800; opacity: 0; width: 14px; }
  .section.done .sec-head .tick { opacity: 1; }

  .sec-body { display: none; }
  .section.open .sec-body { display: block; }

  .row {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 11px 16px; min-height: var(--tap);
    border-top: 1px solid var(--line); cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sec-body .row:first-child { border-top: 0; }
  .row .box {
    flex: 0 0 auto; margin-top: 1px;
    width: 24px; height: 24px; border-radius: 7px;
    border: 2px solid var(--line-strong); background: var(--surface-2);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 15px; font-weight: 800;
  }
  .row.checked .box { background: var(--accent); border-color: var(--accent); }
  .row .box .mark { opacity: 0; }
  .row.checked .box .mark { opacity: 1; }
  .row .num {
    flex: 0 0 auto; font-variant-numeric: tabular-nums;
    font-weight: 700; color: var(--ink-muted); font-size: 14px;
    min-width: 22px; margin-top: 2px;
  }
  .row .text { flex: 1 1 auto; font-size: 14.5px; margin-top: 1px; }
  .row.checked .text { color: var(--ink-muted); }
  .row.checked { background: var(--surface-checked); }
  .row .badge {
    flex: 0 0 auto; margin-top: 1px;
    font-size: 11px; font-weight: 800; letter-spacing: .04em;
    color: var(--accent-ink); background: var(--accent-soft);
    border: 1px solid var(--line-strong);
    padding: 3px 7px; border-radius: 6px; min-width: 30px; text-align: center;
    opacity: 0; transition: opacity .12s;
  }
  .row.checked .badge { opacity: 1; }

  /* Footer form */
  .footer-form { padding: 6px 16px 0; }
  .fblock {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 16px; margin-bottom: 12px;
    box-shadow: var(--shadow);
  }
  .fblock h3 {
    margin: 0 0 8px; font-size: 12px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-muted); font-weight: 700;
  }
  textarea {
    width: 100%; min-height: 96px; resize: vertical;
    background: var(--surface-2); color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: 10px;
    padding: 10px 12px; font-size: 15px; font-family: inherit; line-height: 1.45;
  }
  .signoff-grid {
    display: grid; grid-template-columns: 1fr; gap: 12px;
  }
  @media (min-width: 640px) { .signoff-grid { grid-template-columns: 1fr 1fr; } }
  .signoff-grid .field select, .signoff-grid .field input { background: var(--surface-2); }
  .ro {
    min-height: var(--tap); display: flex; align-items: center;
    padding: 6px 10px; font-size: 15px; font-weight: 600;
    background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 10px; color: var(--ink);
  }

  .copy-wrap { padding: 8px 16px 0; }
  .btn-copy {
    width: 100%; min-height: 62px; font-size: 18px; font-weight: 800;
    letter-spacing: .02em; color: #fff; font-family: inherit; cursor: pointer;
    background: linear-gradient(180deg, var(--accent), var(--accent-ink));
    border: 0; border-radius: 14px; box-shadow: var(--shadow);
  }
  .btn-copy:active { filter: brightness(.96); }
  .btn-copy.copied { background: linear-gradient(180deg, var(--ok), var(--ok)); }

  footer.page-foot {
    text-align: center; color: var(--ink-muted);
    font-size: 12px; padding: 24px 16px 0; line-height: 1.5;
  }

  /* Modal fallback */
  .modal-back {
    position: fixed; inset: 0; z-index: 100;
    background: rgba(20,18,15,.55); display: none;
    align-items: center; justify-content: center; padding: 16px;
  }
  .modal-back.show { display: flex; }
  .modal {
    background: var(--surface); color: var(--ink);
    border-radius: 14px; max-width: 720px; width: 100%;
    max-height: 84vh; display: flex; flex-direction: column;
    box-shadow: var(--shadow); border: 1px solid var(--line);
  }
  .modal h3 { margin: 0; padding: 16px; border-bottom: 1px solid var(--line); font-size: 15px; }
  .modal .m-note { padding: 10px 16px 0; font-size: 13px; color: var(--ink-soft); }
  .modal textarea { margin: 12px 16px; width: calc(100% - 32px); min-height: 240px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; }
  .modal .m-actions { padding: 12px 16px; border-top: 1px solid var(--line); display: flex; gap: 10px; justify-content: flex-end; }
  .modal .m-actions button {
    min-height: 44px; padding: 0 16px; font-size: 14px; font-weight: 700;
    border-radius: 10px; font-family: inherit; cursor: pointer;
    border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--ink);
  }
  .modal .m-actions button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }

  .visually-hidden {
    position: absolute !important; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
</head>
<body>

<div class="masthead">
  <div class="brand">Cane &amp; Barrel &nbsp;|&nbsp; Nightly Operations</div>
  <div class="rule"></div>
</div>

<div class="controls">
  <div class="controls-inner wrap">
    <div class="ctl-grid">
      <div class="field">
        <label for="mgr">Closing Manager</label>
        <select id="mgr">
          <option value="" disabled selected>Select closing manager</option>
          <option value="Sam Dash">Sam Dash</option>
          <option value="Heidi Kilcawley">Heidi Kilcawley</option>
          <option value="Dave Velez">Dave Velez</option>
        </select>
      </div>
      <div class="field">
        <label for="date">Date</label>
        <input type="text" id="date" autocomplete="off" spellcheck="false">
      </div>
      <div class="field">
        <label for="day">Day</label>
        <div class="static" id="day">—</div>
      </div>
      <div class="field">
        <label>Shift</label>
        <div class="static">PM / Closing</div>
      </div>
    </div>

    <div class="progress-wrap">
      <div class="progress-top">
        <div class="count"><b id="pDone">0</b> / <span id="pTotal">51</span> complete</div>
        <div class="progress-actions">
          <button class="btn-clear" id="btnClear" type="button">Clear &amp; Start New Shift</button>
        </div>
      </div>
      <div class="bar"><i id="pFill"></i></div>
    </div>
  </div>
</div>

<div class="wrap">
  <p class="instructions">
    Personally verify every action item. Initials are applied automatically when you check an item.
    Document any unresolved issue in the notes section and notify the appropriate leader.
  </p>
</div>

<div class="sections wrap" id="sections"><!-- built by JS --></div>

<div class="footer-form wrap">
  <div class="fblock">
    <h3>Closing Notes / Follow-Up Required</h3>
    <textarea id="notes" placeholder="Document any unresolved issue and note which leader was notified."></textarea>
  </div>

  <div class="fblock">
    <div class="signoff-grid">
      <div class="field">
        <label>Closing Manager</label>
        <div class="ro" id="mgrMirror">—</div>
      </div>
      <div class="field">
        <label for="witness">Manager on Duty / Witness (if required)</label>
        <select id="witness">
          <option value="" selected>—</option>
          <option value="Sam Dash">Sam Dash</option>
          <option value="Heidi Kilcawley">Heidi Kilcawley</option>
          <option value="Dave Velez">Dave Velez</option>
        </select>
      </div>
      <div class="field">
        <label for="timeDone">Time Completed</label>
        <div class="ro" id="timeDone">—</div>
      </div>
      <div class="field">
        <label for="timeSecured">Time Property Secured</label>
        <input type="text" id="timeSecured" autocomplete="off" placeholder="—">
      </div>
    </div>
  </div>
</div>

<div class="copy-wrap wrap">
  <button class="btn-copy" id="btnCopy" type="button">Copy Results for Email</button>
</div>

<footer class="page-foot wrap">
  All items must be verified before the closing manager leaves the property.
</footer>

<div class="modal-back" id="modalBack">
  <div class="modal">
    <h3>Copy the results below</h3>
    <div class="m-note">Clipboard access was blocked. Tap “Select all”, copy, then paste into your email.</div>
    <textarea id="modalText" readonly></textarea>
    <div class="m-actions">
      <button type="button" id="modalSelect">Select all</button>
      <button type="button" class="primary" id="modalClose">Done</button>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";

  var STORAGE_KEY = "caneBarrel.closingChecklist.v1";

  var MANAGERS = ["Sam Dash", "Heidi Kilcawley", "Dave Velez"];

  var SECTIONS = [
    { title: "Inside Bar Closing Standards", items: [
      "Inside bar coolers are fully stocked to the established par levels.",
      "Bar coolers are cleaned inside and out, including doors, handles, shelves, gaskets, and exterior surfaces.",
      "All food, beverage, garnish, and prep items in bar coolers are properly labeled, dated, and covered.",
      "Bar top and all guest-facing bar surfaces are cleaned and sanitized.",
      "All bar tools are cleaned, sanitized, and stowed in their designated locations.",
      "Floor mats are removed, thoroughly cleaned, and left downstairs in the designated area to air-dry.",
      "Bar dishwasher is cleaned; filter is free of debris and no glassware remains inside.",
      "Bar Toast POS terminals and printers are wiped down without spraying cleaner directly onto equipment.",
      "Bar floor is swept and mopped, including behind equipment and beneath accessible areas.",
      "Bar drains are clean and free of debris and standing residue.",
      "All unauthorized or unnecessary items are removed from the bar. POS stations, back bar, and side bar are clean, organized, and not used as catch-all storage areas."
    ]},
    { title: "Outside Bar Closing Standards", items: [
      "Outside-bar coolers are fully stocked to the established par levels.",
      "Outside-bar coolers are cleaned inside and out, including doors, handles, shelves, gaskets, and exterior surfaces.",
      "All food, beverage, garnish, and prep items in outside-bar coolers are properly labeled, dated, and covered.",
      "Outside bar top and all guest-facing bar surfaces are cleaned and sanitized.",
      "All outside-bar tools are cleaned, sanitized, and stowed in their designated locations.",
      "Outside-bar floor mats are removed, thoroughly cleaned, and left downstairs in the designated area to air-dry.",
      "Outside-bar dishwasher is cleaned; filter is free of debris and no glassware remains inside.",
      "Outside-bar Toast POS terminals and printers are wiped down without spraying cleaner directly onto equipment.",
      "Outside-bar floor is swept and mopped, including behind equipment and beneath accessible areas.",
      "Outside-bar drains are clean and free of debris and standing residue.",
      "All unauthorized or unnecessary items are removed from the outside bar. POS stations, back bar, and side bar are clean, organized, and not used as catch-all storage areas."
    ]},
    { title: "Lounge Closing Standards", items: [
      "All Toast POS terminals and printers in the lounge are wiped down without spraying cleaner directly onto equipment.",
      "Lounge tables, stools, chairs, and booths are cleaned, sanitized as appropriate, organized, and aligned.",
      "Lounge floor is swept and mopped, including beneath tables and seating.",
      "Lounge windows and doors are cleaned and free of fingerprints, streaks, and visible residue."
    ]},
    { title: "Patio Dining Closing Standards", items: [
      "Patio dining tables and service surfaces are cleaned and sanitized.",
      "Patio chairs, stools, and other furniture are cleaned, organized, aligned, and returned to the approved floor plan.",
      "Patio dining floor is swept and mopped as appropriate, including beneath tables, chairs, and accessible equipment.",
      "Patio doors, windows, railings, and other guest-facing surfaces are clean and free of fingerprints, streaks, debris, and visible residue."
    ]},
    { title: "Havana Room Closing Standard", items: [
      "Havana Room is thoroughly cleaned, organized, reset to the approved floor plan, and left show-ready for guests, tours, and events."
    ]},
    { title: "Storage Room Closing Standards", items: [
      "Storage room is thoroughly cleaned, swept, and organized; all items are stored in their designated locations and aisles and access points remain clear.",
      "Storage-room freezer is clean and organized; all products are properly labeled, dated, covered, and stored according to food-safety standards.",
      "Expired, damaged, compromised, or unidentifiable products are removed from the storage-room freezer and documented according to procedure.",
      "Liquor cage is clean and organized; all bottles and cases are returned to their designated locations, inventory is secured, and the cage is locked.",
      "Banquet storage is clean and organized; equipment, supplies, and serviceware are returned to their designated locations and stacked safely.",
      "Storage-room reach-in coolers are cleaned inside and out, organized, and free of spills, residue, and debris.",
      "All items in storage-room reach-in coolers are properly labeled, dated, covered, and stored according to food-safety standards; expired or compromised items are discarded and documented."
    ]},
    { title: "Kitchen & Dish Area Closing Standards", items: [
      "All kitchen cooking and holding equipment is turned off in accordance with the approved closing procedure.",
      "All reach-ins, lowboys, and refrigerators are clean and organized.",
      "All food and prep items in reach-ins, lowboys, and refrigerators are properly labeled, dated, and covered.",
      "All expired items and any items showing signs of spoilage, deterioration, or compromised quality are discarded and documented according to procedure.",
      "Dish area is completely cleaned and free of glassware, pots, pans, plateware, food debris, and standing water."
    ]},
    { title: "Cash Handling, Safe & Key Control", items: [
      "All employee banks are counted and verified as accurate.",
      "Cash drops are completed before employees leave and are deposited in the safe according to cash-handling procedure.",
      "All required cash validations and discrepancies are properly recorded in the cash-handling book.",
      "Petty cash in the downstairs safe is counted and verified against the approved balance.",
      "All employee key cards are gathered, accounted for, and signed back in on the daily key-control log.",
      "All building and operational keys are returned and deposited in the safe according to the approved key-control procedure.",
      "The safe key and all employee key cards are secured in the Director's office before the closing manager leaves the property.",
      "All FOH and BOH employee time punches are reviewed to ensure each employee has properly clocked in and out for the shift."
    ]}
  ];

  var TOTAL = SECTIONS.reduce(function (n, s) { return n + s.items.length; }, 0); // 51

  // ---- State ----
  var state = {
    manager: "",
    date: "",
    witness: "",
    notes: "",
    timeSecured: "",
    checks: {}   // key "s-i" -> initials string
  };

  // ---- Helpers ----
  var MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  var DAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];

  function initialsFor(name) {
    if (!name) return "";
    var parts = name.trim().split(/\s+/);
    return parts.map(function (p) { return p.charAt(0).toUpperCase(); }).join("");
  }

  function formatDate(d) {
    return MONTHS[d.getMonth()] + " " + d.getDate() + ", " + d.getFullYear();
  }

  function parseDate(str) {
    // Expect "August 8, 2026"; return Date or null
    var m = /^([A-Za-z]+)\s+(\d{1,2}),\s*(\d{4})$/.exec((str || "").trim());
    if (!m) return null;
    var mi = MONTHS.indexOf(m[1].charAt(0).toUpperCase() + m[1].slice(1).toLowerCase());
    if (mi < 0) return null;
    var d = new Date(parseInt(m[3], 10), mi, parseInt(m[2], 10));
    if (isNaN(d.getTime())) return null;
    return d;
  }

  function dayFromDateString(str) {
    var d = parseDate(str);
    return d ? DAYS[d.getDay()] : "—";
  }

  function nowTimeString() {
    var d = new Date();
    var h = d.getHours(), m = d.getMinutes();
    var ap = h >= 12 ? "PM" : "AM";
    var hh = h % 12; if (hh === 0) hh = 12;
    var mm = m < 10 ? "0" + m : "" + m;
    return hh + ":" + mm + " " + ap;
  }

  function esc(s) {
    return String(s).replace(/[&<>"]/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
    });
  }

  // ---- Persistence ----
  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
  }
  function load() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      var obj = JSON.parse(raw);
      if (obj && typeof obj === "object") {
        state.manager = obj.manager || "";
        state.date = obj.date || "";
        state.witness = obj.witness || "";
        state.notes = obj.notes || "";
        state.timeSecured = obj.timeSecured || "";
        state.checks = (obj.checks && typeof obj.checks === "object") ? obj.checks : {};
        return true;
      }
    } catch (e) {}
    return false;
  }

  // ---- DOM refs ----
  var elSections = document.getElementById("sections");
  var elMgr = document.getElementById("mgr");
  var elDate = document.getElementById("date");
  var elDay = document.getElementById("day");
  var elWitness = document.getElementById("witness");
  var elNotes = document.getElementById("notes");
  var elTimeDone = document.getElementById("timeDone");
  var elTimeSecured = document.getElementById("timeSecured");
  var elMgrMirror = document.getElementById("mgrMirror");
  var elPDone = document.getElementById("pDone");
  var elPFill = document.getElementById("pFill");
  var elBtnCopy = document.getElementById("btnCopy");
  var elBtnClear = document.getElementById("btnClear");

  var sectionEls = []; // {wrap, head, count, body, rows:[{row, badge, key}]}

  // ---- Build checklist DOM ----
  function build() {
    var num = 0;
    SECTIONS.forEach(function (sec, si) {
      var wrap = document.createElement("section");
      wrap.className = "section open";

      var head = document.createElement("button");
      head.type = "button";
      head.className = "sec-head";
      head.setAttribute("aria-expanded", "true");

      var chev = document.createElement("span"); chev.className = "chev"; chev.textContent = "▶";
      var title = document.createElement("span"); title.className = "title"; title.textContent = sec.title;
      var count = document.createElement("span"); count.className = "sec-count"; count.textContent = "0 / " + sec.items.length;
      var tick = document.createElement("span"); tick.className = "tick"; tick.textContent = "✓";
      head.appendChild(chev); head.appendChild(title); head.appendChild(count); head.appendChild(tick);

      var body = document.createElement("div"); body.className = "sec-body";

      var rows = [];
      sec.items.forEach(function (text, ii) {
        num++;
        var key = si + "-" + ii;
        var row = document.createElement("div");
        row.className = "row";
        row.setAttribute("role", "checkbox");
        row.setAttribute("aria-checked", "false");
        row.setAttribute("tabindex", "0");

        var box = document.createElement("span"); box.className = "box";
        var mark = document.createElement("span"); mark.className = "mark"; mark.textContent = "✓";
        box.appendChild(mark);

        var n = document.createElement("span"); n.className = "num"; n.textContent = num + ".";
        var t = document.createElement("span"); t.className = "text"; t.textContent = text;
        var badge = document.createElement("span"); badge.className = "badge"; badge.textContent = "";

        row.appendChild(box); row.appendChild(n); row.appendChild(t); row.appendChild(badge);

        (function (k, r, b) {
          function toggle() { onToggle(k, r, b); }
          r.addEventListener("click", toggle);
          r.addEventListener("keydown", function (e) {
            if (e.key === " " || e.key === "Enter") { e.preventDefault(); toggle(); }
          });
        })(key, row, badge);

        body.appendChild(row);
        rows.push({ row: row, badge: badge, key: key });
      });

      head.addEventListener("click", function () { toggleSection(si); });

      wrap.appendChild(head);
      wrap.appendChild(body);
      elSections.appendChild(wrap);

      sectionEls.push({ wrap: wrap, head: head, count: count, body: body, rows: rows, size: sec.items.length });
    });
  }

  function toggleSection(si) {
    var s = sectionEls[si];
    var open = s.wrap.classList.toggle("open");
    s.head.setAttribute("aria-expanded", open ? "true" : "false");
  }

  // ---- Toggle an item ----
  function onToggle(key, row, badge) {
    var checked = !!state.checks[key];
    if (!checked) {
      // turning ON
      if (!state.manager) {
        alert("Select a closing manager first.");
        elMgr.focus();
        return;
      }
      state.checks[key] = initialsFor(state.manager);
    } else {
      delete state.checks[key];
    }
    applyRow(key, row, badge);
    save();
    refreshProgress();
    refreshSection(sectionForKey(key), true);
  }

  function sectionForKey(key) { return parseInt(key.split("-")[0], 10); }

  function applyRow(key, row, badge) {
    var initials = state.checks[key];
    if (initials) {
      row.classList.add("checked");
      row.setAttribute("aria-checked", "true");
      badge.textContent = initials;
    } else {
      row.classList.remove("checked");
      row.setAttribute("aria-checked", "false");
      badge.textContent = "";
    }
  }

  function sectionDoneCount(si) {
    var s = sectionEls[si], c = 0;
    s.rows.forEach(function (r) { if (state.checks[r.key]) c++; });
    return c;
  }

  function refreshSection(si, allowAutoCollapse) {
    var s = sectionEls[si];
    var c = sectionDoneCount(si);
    s.count.textContent = c + " / " + s.size;
    if (c === s.size) {
      s.wrap.classList.add("done");
      if (allowAutoCollapse && s.wrap.classList.contains("open")) {
        s.wrap.classList.remove("open");
        s.head.setAttribute("aria-expanded", "false");
      }
    } else {
      s.wrap.classList.remove("done");
    }
  }

  function totalDone() {
    var n = 0;
    for (var k in state.checks) { if (state.checks.hasOwnProperty(k)) n++; }
    return n;
  }

  function refreshProgress() {
    var done = totalDone();
    elPDone.textContent = done;
    elPFill.style.width = (TOTAL ? (done / TOTAL * 100) : 0) + "%";
  }

  // ---- Render full state into DOM ----
  function renderAll() {
    elMgr.value = state.manager || "";
    elMgrMirror.textContent = state.manager || "—";
    elWitness.value = state.witness || "";
    elNotes.value = state.notes || "";
    elDate.value = state.date || "";
    elDay.textContent = dayFromDateString(state.date);
    elTimeSecured.value = state.timeSecured || "";
    sectionEls.forEach(function (s, si) {
      s.rows.forEach(function (r) { applyRow(r.key, r.row, r.badge); });
      refreshSection(si, false);
    });
    refreshProgress();
  }

  // ---- Header control events ----
  elMgr.addEventListener("change", function () {
    state.manager = elMgr.value;
    elMgrMirror.textContent = state.manager || "—";
    save();
  });
  elDate.addEventListener("input", function () {
    state.date = elDate.value;
    elDay.textContent = dayFromDateString(state.date);
    save();
  });
  elWitness.addEventListener("change", function () { state.witness = elWitness.value; save(); });
  elNotes.addEventListener("input", function () { state.notes = elNotes.value; save(); });
  elTimeSecured.addEventListener("input", function () { state.timeSecured = elTimeSecured.value; save(); });

  elBtnClear.addEventListener("click", function () {
    if (!confirm("Clear all checks, initials, notes, and saved data to start a new shift? This cannot be undone.")) return;
    try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
    state = { manager: "", date: "", witness: "", notes: "", timeSecured: "", checks: {} };
    var d = new Date();
    state.date = formatDate(d);
    elTimeDone.textContent = "—";
    renderAll();
  });

  // ---- Build email payloads ----
  function buildPlain(times) {
    var L = [];
    L.push("CANE & BARREL — NIGHTLY MANAGER CLOSING CHECKLIST");
    L.push("");
    L.push("Date: " + (state.date || "—"));
    L.push("Day: " + dayFromDateString(state.date));
    L.push("Shift: PM / Closing");
    L.push("Closing Manager: " + (state.manager || "—"));
    L.push("Time Completed: " + times.done);
    L.push("Time Property Secured: " + (state.timeSecured || times.done));
    L.push("Manager on Duty / Witness: " + (state.witness || "—"));
    L.push(totalDone() + " of " + TOTAL + " items verified");
    L.push("");
    var num = 0;
    SECTIONS.forEach(function (sec, si) {
      L.push(sec.title.toUpperCase());
      sec.items.forEach(function (text, ii) {
        num++;
        var key = si + "-" + ii;
        var initials = state.checks[key];
        var mark = initials ? "[X]" : "[ ]";
        L.push("  " + mark + " " + num + ". " + text + (initials ? "  (" + initials + ")" : ""));
      });
      L.push("");
    });
    L.push("CLOSING NOTES / FOLLOW-UP REQUIRED");
    L.push("  " + (state.notes.trim() ? state.notes.trim() : "None"));
    L.push("");
    L.push("Closing Manager: " + (state.manager || "—"));
    L.push("Manager on Duty / Witness: " + (state.witness || "—"));
    L.push("Time Completed: " + times.done);
    L.push("Time Property Secured: " + (state.timeSecured || times.done));
    return L.join("\n");
  }

  function buildHtml(times) {
    var FONT = "font-family:Arial,Helvetica,sans-serif;";
    var done = totalDone();
    var h = [];
    h.push('<div style="' + FONT + 'color:#23201b;max-width:700px;">');
    h.push('<h2 style="' + FONT + 'font-size:19px;margin:0 0 4px;color:#7a5417;">Cane &amp; Barrel — Nightly Manager Closing Checklist</h2>');
    h.push('<hr style="border:0;border-top:2px solid #b07d2b;margin:6px 0 12px;">');

    // Header block table
    h.push('<table cellpadding="4" cellspacing="0" border="0" width="700" style="' + FONT + 'font-size:13px;border-collapse:collapse;margin-bottom:14px;">');
    function hrow(label, val) {
      return '<tr><td width="200" style="' + FONT + 'font-size:13px;color:#6b6459;font-weight:bold;vertical-align:top;">' + esc(label) + '</td>' +
             '<td style="' + FONT + 'font-size:13px;color:#23201b;">' + esc(val) + '</td></tr>';
    }
    h.push(hrow("Date", state.date || "—"));
    h.push(hrow("Day", dayFromDateString(state.date)));
    h.push(hrow("Shift", "PM / Closing"));
    h.push(hrow("Closing Manager", state.manager || "—"));
    h.push(hrow("Time Completed", times.done));
    h.push(hrow("Time Property Secured", state.timeSecured || times.done));
    h.push(hrow("Manager on Duty / Witness", state.witness || "—"));
    h.push('<tr><td width="200" style="' + FONT + 'font-size:13px;color:#6b6459;font-weight:bold;">Completion</td>' +
           '<td style="' + FONT + 'font-size:13px;color:#23201b;font-weight:bold;">' + done + ' of ' + TOTAL + ' items verified</td></tr>');
    h.push('</table>');

    var num = 0;
    SECTIONS.forEach(function (sec, si) {
      h.push('<div style="' + FONT + 'font-size:13px;font-weight:bold;letter-spacing:.04em;text-transform:uppercase;color:#7a5417;background:#f0e2c6;padding:6px 8px;margin:0 0 0;border:1px solid #ddd5c7;border-bottom:0;">' + esc(sec.title) + '</div>');
      h.push('<table cellpadding="6" cellspacing="0" border="1" width="700" style="' + FONT + 'font-size:13px;border-collapse:collapse;border-color:#ddd5c7;margin:0 0 12px;">');
      sec.items.forEach(function (text, ii) {
        num++;
        var key = si + "-" + ii;
        var initials = state.checks[key];
        var ok = !!initials;
        var rowStyle = ok ? "" : "background:#f9e6e2;";
        var statusCell = ok
          ? '<td width="34" align="center" style="' + FONT + 'font-size:14px;color:#2f7d4f;font-weight:bold;' + rowStyle + '">&#10003;</td>'
          : '<td width="34" align="center" style="' + FONT + 'font-size:14px;color:#b23b2e;font-weight:bold;' + rowStyle + '">&#10007;</td>';
        h.push('<tr style="' + rowStyle + '">' +
          statusCell +
          '<td width="34" align="center" style="' + FONT + 'font-size:13px;color:#6b6459;' + rowStyle + '">' + num + '</td>' +
          '<td style="' + FONT + 'font-size:13px;color:#23201b;' + rowStyle + '">' + esc(text) + '</td>' +
          '<td width="60" align="center" style="' + FONT + 'font-size:13px;color:#7a5417;font-weight:bold;' + rowStyle + '">' + (initials ? esc(initials) : "") + '</td>' +
        '</tr>');
      });
      h.push('</table>');
    });

    h.push('<div style="' + FONT + 'font-size:13px;font-weight:bold;text-transform:uppercase;color:#7a5417;margin:8px 0 4px;">Closing Notes / Follow-Up Required</div>');
    h.push('<div style="' + FONT + 'font-size:13px;color:#23201b;border:1px solid #ddd5c7;padding:8px;margin-bottom:14px;white-space:pre-wrap;">' + (state.notes.trim() ? esc(state.notes.trim()) : "None") + '</div>');

    h.push('<table cellpadding="4" cellspacing="0" border="0" width="700" style="' + FONT + 'font-size:13px;border-top:2px solid #b07d2b;padding-top:8px;">');
    h.push(hrow("Closing Manager", state.manager || "—"));
    h.push(hrow("Manager on Duty / Witness", state.witness || "—"));
    h.push(hrow("Time Completed", times.done));
    h.push(hrow("Time Property Secured", state.timeSecured || times.done));
    h.push('</table>');

    h.push('</div>');
    return h.join("");
  }

  // ---- Copy button (synchronous clipboard write) ----
  var copyResetTimer = null;

  elBtnCopy.addEventListener("click", function () {
    // 1. capture time synchronously
    var t = nowTimeString();
    elTimeDone.textContent = t;
    if (!state.timeSecured) {
      state.timeSecured = t;
      elTimeSecured.value = t;
    }
    save();
    var times = { done: t };

    var plain = buildPlain(times);
    var html = buildHtml(times);

    var wroteAsync = false;

    // 2. Try modern async clipboard write — but fire it synchronously (no await before it)
    if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
      try {
        var item = new ClipboardItem({
          "text/html": new Blob([html], { type: "text/html" }),
          "text/plain": new Blob([plain], { type: "text/plain" })
        });
        wroteAsync = true;
        navigator.clipboard.write([item]).then(function () {
          showCopied();
        }).catch(function () {
          if (!legacyCopy(html, plain)) showModal(plain);
          else showCopied();
        });
      } catch (e) {
        wroteAsync = false;
      }
    }

    if (!wroteAsync) {
      if (legacyCopy(html, plain)) showCopied();
      else showModal(plain);
    }
  });

  function legacyCopy(html, plain) {
    // hidden contenteditable + execCommand('copy')
    try {
      var div = document.createElement("div");
      div.setAttribute("contenteditable", "true");
      div.style.position = "fixed";
      div.style.left = "-9999px";
      div.style.top = "0";
      div.style.whiteSpace = "pre-wrap";
      div.innerHTML = html;
      document.body.appendChild(div);

      var range = document.createRange();
      range.selectNodeContents(div);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);

      var ok = false;
      try { ok = document.execCommand("copy"); } catch (e) { ok = false; }

      sel.removeAllRanges();
      document.body.removeChild(div);
      return ok;
    } catch (e) {
      return false;
    }
  }

  function showCopied() {
    elBtnCopy.classList.add("copied");
    elBtnCopy.textContent = "Copied ✓";
    if (copyResetTimer) clearTimeout(copyResetTimer);
    copyResetTimer = setTimeout(function () {
      elBtnCopy.classList.remove("copied");
      elBtnCopy.textContent = "Copy Results for Email";
    }, 2000);
  }

  // ---- Modal fallback ----
  var modalBack = document.getElementById("modalBack");
  var modalText = document.getElementById("modalText");
  document.getElementById("modalSelect").addEventListener("click", function () {
    modalText.focus(); modalText.select();
    try { document.execCommand("copy"); } catch (e) {}
  });
  document.getElementById("modalClose").addEventListener("click", function () {
    modalBack.classList.remove("show");
  });
  modalBack.addEventListener("click", function (e) {
    if (e.target === modalBack) modalBack.classList.remove("show");
  });
  function showModal(plain) {
    modalText.value = plain;
    modalBack.classList.add("show");
    setTimeout(function () { modalText.focus(); modalText.select(); }, 30);
  }

  // ---- Init ----
  function init() {
    build();
    var had = load();
    if (!state.date) state.date = formatDate(new Date());
    renderAll();
  }

  init();
})();
</script>
</body>
</html>
